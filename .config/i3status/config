general {
    output_format = "i3bar"
    colors = true
    interval = 1
}

order += "memory"
order += "cpu_usage"
order += "cpu_temperature 0"
order += "volume master"
order += "battery all"
order += "tztime local"

memory {
    format = " mem: %percentage_used "
}

cpu_usage {
    format = " cpu: %usage "
}

cpu_temperature 0 {
    format = " temp: %degreesC "
    path = "/sys/class/thermal/thermal_zone0/temp"
}

volume master {
    format = " vol: %volume "
    format_muted = " vol: %volume (m) "
}

battery all {
    format = " %status %percentage "
    format_down = " No battery "
    status_chr = "ac:"
    status_bat = "bat:"
    status_full = "full:"
}

tztime local {
    format = " %H:%M %A, %b %d "
}